# FULL: every ported muLLM item on dsv41-lowlat-full, EP1, both SWA replay flags off (#N = muLLM item number)
--ep-size 1
# breakable prefill CUDA graph up to 8K-token chunks and a 262,144-token context (DSV4 keeps it off by default)
--cuda-graph-backend-prefill breakable
--cuda-graph-bs-prefill 128 256 512 1024 2048 3072 4096 6144 8192
--cuda-graph-prefill-max-context 262144
--cuda-graph-max-seq-len-prefill 262144
# pinned compressed-lengths upload in the eager sparse-prefill break, so it does not block the host under the graph
SGLANG_OPT_DSV41_PREFILL_ASYNC_H2D=1
# compile every serving-time prefill / mixed / batch kernel variant before the server reports ready
SGLANG_OPT_DSV41_PRECOMPILE_PREFILL=1
# #14 routed-expert GEMMs (needs --ep-size 1), past muLLM's 8 rows up to 48 (several 8-row tiles per expert)
SGLANG_OPT_DSV41_ROUTED_EXPERT_GEMM=1
SGLANG_OPT_DSV41_ROUTED_EXPERT_GEMM_MAX_ROWS=48
# #8 low-latency MXFP8 projections + pinned tactics, #24 LM head, #9 compressor part; rng-only speculative TP sync (minus the sampling-accept broadcast, see the block-wise sampler below)
SGLANG_OPT_DSV41_LOW_LATENCY_MXFP8=1
SGLANG_OPT_DSV41_LOW_LATENCY_MXFP8_PINNED_TACTICS=1
SGLANG_OPT_DSV41_LOW_LATENCY_LM_HEAD=1
SGLANG_OPT_DSV41_LOW_LATENCY_COMPRESSOR=1
SGLANG_OPT_DSV41_LOW_LATENCY_COMPRESSOR_MAX_ROWS=16
SGLANG_SPEC_TP_SYNC=rng,-dspark-accept-sample
# #16 draft fused all-reduce + mHC posts; small-M mHC coefficient GEMM (muLLM's coefficient path)
SGLANG_OPT_DSV41_DRAFT_FUSED_MHC_ALL_REDUCE=1
SGLANG_OPT_DSV41_SMALL_M_HC_PRENORM=1
# #1 attention-metadata graph, #20 one-launch step inputs, #26 lean step prep, #19 post-forward region in the verify graph
SGLANG_OPT_DSV41_ATTN_METADATA_GRAPH=1
SGLANG_OPT_DSV41_DSPARK_PREPARE_INPUTS_ONCE=1
SGLANG_OPT_DSV41_LEAN_PREP_INPUTS=1
SGLANG_OPT_DSV41_POST_FORWARD_CUDA_GRAPH=1
# #19 temperature batches: sampling accept in one graph per batch size; precompile its kernels at startup
SGLANG_OPT_DSV41_SAMPLING_ACCEPT_GRAPH=1
SGLANG_OPT_DSV41_PRECOMPILE_SAMPLING_ACCEPT=1
# block-wise rejection sampler; its counter-based draws let the sync above drop the accept-site broadcast
SGLANG_OPT_DSV41_BLOCKWISE_REJECTION=1
# #7 aux mean side stream, #13 Engram WKV prefetch (needs the shared host Engram table), #9 indexer weights_proj, #10 indexer side streams, #5 wo_b publish
SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=1
SGLANG_OPT_DSV41_AUX_MEAN_SIDE_STREAM=1
SGLANG_OPT_DSV41_PREFETCH_ENGRAM_WKV=1
SGLANG_OPT_DSV41_LOW_LATENCY_INDEXER_WEIGHTS=1
SGLANG_OPT_DSV41_LOW_LATENCY_INDEXER=1
SGLANG_OPT_DSV41_WO_B_PUBLISH=1
# #15 draft MoE fast paths, #18 draft context-KV side stream, #22 one-kernel sharded Markov chain
SGLANG_OPT_DSV41_DRAFT_FAST_PATHS=1
SGLANG_OPT_DSV41_DSPARK_CONTEXT_SIDE_STREAM=1
SGLANG_OPT_DSV41_DSPARK_SHARDED_MARKOV=1
SGLANG_OPT_DSV41_DSPARK_SHARDED_MARKOV_TIMEOUT_MS=20000
# 16-head Gluon swap-AB sparse decode attention to 24 rows (FlashMLA pads to 64 heads past it)
SGLANG_OPT_DSV41_SWAPAB_MAX_ROWS=24
# Its partial + combine kernels launched with PDL, and the split-KV combine as one-warp programs
SGLANG_OPT_DSV41_SWAPAB_PDL=1
SGLANG_OPT_DSV41_SWAPAB_NARROW_COMBINE=1
