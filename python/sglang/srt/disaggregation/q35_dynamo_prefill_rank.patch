+#[test]
+fn q35_decode_rank_does_not_pin_prefill_affinity() {
+    for rank in [0, 1, 3] {
+        let routing = RoutingHints {
+            decode_worker_id: Some(7), dp_rank: Some(rank), ..Default::default()
+        };
+        let request = request_with_routing(routing.clone());
+        assert_eq!(explicit_target(&request, RequestPhase::Prefill).unwrap(), None);
+        assert_eq!(explicit_target(&request, RequestPhase::Decode).unwrap(), Some(target(7, Some(rank))));
+        let request = request_with_routing(RoutingHints { prefill_worker_id: Some(8), ..routing.clone() });
+        assert_eq!(explicit_target(&request, RequestPhase::Prefill).unwrap(), Some(target(8, None)));
+        let request = request_with_routing(RoutingHints { prefill_worker_id: Some(8), prefill_dp_rank: Some(0), ..routing });
+        assert_eq!(explicit_target(&request, RequestPhase::Prefill).unwrap(), Some(target(8, Some(0))));
+    }
+    let legacy = request_with_routing(RoutingHints { backend_instance_id: Some(9), dp_rank: Some(2), ..Default::default() });
+    assert_eq!(explicit_target(&legacy, RequestPhase::Prefill).unwrap(), Some(target(9, Some(2))));
